# ==========================================
# CONFIGURAÇÕES DO TELEGRAM (Opcional)
# ==========================================
# Deixe em branco para usar apenas no Terminal / Painel Web sem bot do Telegram.
# Para ativar, crie um bot no @BotFather (formato: 123456789:ABCdef...) e informe seu Chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==========================================
# ROTA PADRÃO & JANELAS HORÁRIAS
# ==========================================
# Usadas por eventos de calendário (.ics), `event_date` no JSON e comandos rápidos (/adicionar, /evento)
DEFAULT_ORIGIN=rio-de-janeiro-rj
DEFAULT_DESTINATION=cacapava-sp
DEFAULT_HUBS=sao-jose-dos-campos-sp,taubate-sp

# Deslocamento em dias em relação à data de um evento (ex.: D-1 na ida, D0 na volta)
EVENT_OUTBOUND_DAY_OFFSET=-1
EVENT_RETURN_DAY_OFFSET=0

# Janelas de horário padrão para a IDA (HH:MM)
DEFAULT_OUTBOUND_DEPART_AFTER=18:00
DEFAULT_OUTBOUND_DEPART_BEFORE=22:00
DEFAULT_OUTBOUND_ARRIVE_BEFORE=

# Janelas de horário padrão para a VOLTA (HH:MM)
DEFAULT_RETURN_DEPART_AFTER=20:00
DEFAULT_RETURN_DEPART_BEFORE=23:59
DEFAULT_RETURN_ARRIVE_BEFORE=07:15
DEFAULT_RETURN_ARRIVE_DAY_OFFSET=1

# ==========================================
# ROTEAMENTO & CONEXÕES REGIONAIS
# ==========================================
# Máximo de conexões/baldeações aceitas (0 = somente direto, 1 = permite hub intermediário)
MAX_TRANSFERS=1
MIN_CONNECTION_MINUTES=30
# Conexões locais estimadas entre hub e destino final: cidade-a|cidade-b|custo_reais|minutos
LOCAL_CONNECTIONS=sao-jose-dos-campos-sp|cacapava-sp|12.00|35;taubate-sp|cacapava-sp|10.00|25;aparecida-sp|guaratingueta-sp|6.50|15

# ==========================================
# CONFIGURAÇÕES DO CALENDÁRIO & FONTES
# ==========================================
# URL pública/privada de arquivo .ics (Google Calendar / iCal) ou caminho local
CALENDAR_ICS_URL=
# Palavras-chave para filtrar eventos do calendário (vazio = importa todos)
CALENDAR_KEYWORDS=prova,exame,presencial,#viagem
# Caminho para arquivo local de viagens manuais
LOCAL_TRIPS_FILE=data/viagens.json

# ==========================================
# CRITÉRIOS DE PREÇO & ALERTAS
# ==========================================
# Faixa de preço máximo considerado "bom" e "excelente" (R$ por trecho)
TARGET_PRICE_GOOD=80.00
TARGET_PRICE_EXCELLENT=70.00
PRICE_DROP_ALERT=5.00

# Gatilhos de antecedência para alerta (em dias)
ALERT_DAYS_BEFORE=30,15,7,3,1

# Limite crítico de assentos disponíveis para alerta de urgência
MIN_SEATS_CRITICAL=5
HISTORY_WINDOW_DAYS=30
MONITOR_HORIZON_DAYS=120

# ==========================================
# PROVEDORES E AGENDAMENTO
# ==========================================
# Provedores ativos (padrão: buser)
ENABLED_PROVIDERS=buser
REQUEST_DELAY_SECONDS=2.0
REQUEST_TIMEOUT_SECONDS=25.0

# Horários fixos de verificação diária no modo daemon (HH:MM, separados por vírgula)
DAILY_RUN_TIMES=07:30,19:30
# Ou intervalo contínuo em horas (0 = usar apenas DAILY_RUN_TIMES)
CHECK_INTERVAL_HOURS=0
DAILY_SUMMARY=true

# ==========================================
# BANCO DE DADOS E LOGS
# ==========================================
DATABASE_URL=sqlite:///data/bustracker.db
LOG_LEVEL=INFO
TZ_NAME=America/Sao_Paulo
